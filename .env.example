# TikTok Login Kit / Content Posting API application credentials.
# Never prefix secrets with VITE_. Never commit the filled .env.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Fixed TikTok redirect: https://arter2k.github.io/AutoClippingUpgrader/callback

# Google OAuth client type: Desktop app. Enable Google Drive API v3.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Default: only files/folders granted to or created by this application.
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file
# For listing/selecting arbitrary existing folders instead (requires broader consent/verification):
# GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive
