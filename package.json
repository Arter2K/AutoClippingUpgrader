{
  "name": "auto-clipping-upgrader",
  "productName": "AutoClippingUpgrader",
  "description": "Vertical video editor with template compositing, FFmpeg rendering and publishing integrations",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "prepare:ai": "node scripts/prepare-ai.cjs",
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "dist:win": "tsc --noEmit && electron-vite build && node scripts/package-win.cjs",
    "test:package": "node scripts/test-package.cjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:electron": "node scripts/test-editor.cjs tests/electron/storage-smoke.cjs tests/electron/ipc-smoke.cjs",
    "test:editor": "node scripts/test-editor.cjs",
    "engine": "tsx scripts/render.ts",
    "demo": "tsx scripts/demo.ts",
    "test:effects": "node scripts/test-effects.cjs"
  },
  "dependencies": {
    "@imgly/background-removal": "1.7.0",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fontkit": "^2.0.4",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
