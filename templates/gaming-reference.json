{
  "template_id": "tpl_vertical_gaming_pro_01",
  "template_name": "TikTok / Shorts Gaming 9:16 (Blur + HUD)",
  "version": "1.0.0",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "aspect_ratio": "9:16",
    "fps": 60,
    "background_color": "#09090b"
  },
  "main_clip_layout": {
    "source_aspect_handling": "blur_pad",
    "Position": {
      "x": 0,
      "y": 420,
      "width": 1080,
      "height": 1080,
      "scale_mode": "fit_width"
    },
    "background_blur": {
      "enabled": true,
      "luma_radius": 25,
      "luma_power": 2,
      "brightness": -0.15,
      "scale_height": 1920
    }
  },
  "overlays": [
    {
      "id": "ov_watermark_logo",
      "type": "image",
      "name": "Channel Watermark",
      "source_path": "./assets/overlays/logo_banner.png",
      "z_index": 10,
      "position": {
        "x": 340,
        "y": 280,
        "width": 400,
        "height": 100
      },
      "opacity": 0.95,
      "timing": {
        "full_duration": true,
        "start_offset_sec": 0,
        "end_offset_sec": null,
        "fade_in_sec": 0.3,
        "fade_out_sec": 0.3
      }
    },
    {
      "id": "ov_dynamic_caption",
      "type": "text",
      "name": "Top Hook Title",
      "text_content": "HIGHLIGHT CLIP",
      "z_index": 20,
      "position": {
        "x": 540,
        "y": 1520,
        "anchor": "center"
      },
      "style": {
        "font_family": "Montserrat-Bold",
        "font_file": "./assets/fonts/Montserrat-Bold.ttf",
        "font_size": 64,
        "font_color": "#FFFFFF",
        "stroke_color": "#000000",
        "stroke_width": 4,
        "shadow_color": "rgba(0,0,0,0.6)",
        "shadow_x": 2,
        "shadow_y": 4
      },
      "timing": {
        "full_duration": false,
        "start_offset_sec": 0.0,
        "end_offset_sec": 4.5,
        "fade_in_sec": 0.2,
        "fade_out_sec": 0.2
      }
    }
  ],
  "render_preset": {
    "target_platform": "tiktok_shorts",
    "container": "mp4",
    "video": {
      "codec": "h264_nvenc",
      "fallback_codec": "libx264",
      "rate_control": "vbr",
      "target_bitrate_kbps": 18000,
      "max_bitrate_kbps": 24000,
      "bufsize_kbps": 36000,
      "profile": "high",
      "level": "4.2",
      "pixel_format": "yuv420p",
      "nvenc_preset": "p6",
      "gop_size": 120
    },
    "audio": {
      "codec": "aac",
      "bitrate_kbps": 256,
      "sample_rate": 48000,
      "normalize_loudness": true
    }
  },
  "publish_defaults": {
    "tiktok": {
      "mode": "direct_post",
      "default_caption_suffix": "#gaming #clips #fyp #viral",
      "privacy_level": "SELF_ONLY",
      "disable_comment": false,
      "disable_duet": false,
      "disable_stitch": false
    },
    "google_drive": {
      "auto_upload": true,
      "target_folder_name": "AutoClipping_Renders"
    }
  }
}
